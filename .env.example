### Example environment variables for Ralph
# Copy this file to `.env` and fill in the values. Keep `.env` out of source control.

RALPH_TELEGRAM_BOT_TOKEN=your_bot_token_here
RALPH_TELEGRAM_CHAT_ID=your_chat_id_here
RALPH_TELEGRAM_STATUS_INTERVAL=60 # Periodic status update interval in minutes (0 to disable)
RALPH_TELEGRAM_ALLOWED_USERS=user1,user2 # Comma-separated list of allowed Telegram usernames or user IDs