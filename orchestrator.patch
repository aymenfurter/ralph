+                        this.ui.addLog('Telegram: /chat failed.');
+                        await this.notifyTelegram('Failed to send prompt to Copilot Chat.');
+                    }
+                }
+            } else {
+                await this.handleTelegramCommand(msg);
+            }
+        }
